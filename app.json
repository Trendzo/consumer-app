{
  "expo": {
    "name": "Trendzo",
    "slug": "Trendzo",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trendzo.consumer",
      "buildNumber": "7",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Trendzo saves your try-on looks to your photo library when you tap Save."
      }
    },
    "android": {
      "package": "com.trendzo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withReleaseSlimming",
      "./plugins/withIosBundleScriptSpaceFix",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/HelveticaNeueBlack.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Helvetica Neue",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/HelveticaNeue-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/HelveticaNeue-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/HelveticaNeue-Medium.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/HelveticaNeue-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-video",
        {
          "microphonePermission": "Trendzo uses the microphone for video features."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Trendzo needs your camera to let you try on outfits live.",
          "microphonePermission": "Trendzo needs the microphone for live try-on video."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Trendzo needs access to your photos so you can try on or search with your own images."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Trendzo uses your location to show the stores that can deliver to you and how quickly, and to pin a delivery address on the map. It is never used in the background.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0b470b68-c1e0-436e-97ac-db5918968650"
      }
    },
    "owner": "chandreshheree"
  }
}
